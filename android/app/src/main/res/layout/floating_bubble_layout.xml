<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 1. Collapsed Floating Circular Bubble (Default View) -->
    <FrameLayout
        android:id="@+id/bubble_collapsed_layout"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bubble_circle_bg">

        <TextView
            android:id="@+id/bubble_collapsed_count_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </FrameLayout>

    <!-- 2. Expanded Floating Mini Counter Card -->
    <LinearLayout
        android:id="@+id/bubble_expanded_layout"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_card_bg"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <!-- Header Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="COUNTER BUBBLE"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Close Entire Bubble Service Button -->
            <ImageView
                android:id="@+id/bubble_btn_close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#94A3B8"
                android:contentDescription="Close Bubble" />
        </RelativeLayout>

        <!-- Interactive Row: [-] [Count] [+] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Minus Button -->
            <Button
                android:id="@+id/bubble_btn_minus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/counter_btn_minus"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp" />

            <!-- Center Count Text -->
            <TextView
                android:id="@+id/bubble_count_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0"
                android:textColor="#0F172A"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Plus Button -->
            <Button
                android:id="@+id/bubble_btn_plus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/counter_btn_plus"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Action Row: Reset & Collapse -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/bubble_btn_reset"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/counter_btn_reset"
                android:text="Reset"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp" />

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/bubble_btn_collapse"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/counter_btn_reset"
                android:text="Minimize"
                android:textColor="#3B82F6"
                android:textSize="11sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
