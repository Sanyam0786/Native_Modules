<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_counter_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/counter_widget_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Header Title -->
    <TextView
        android:id="@+id/widget_counter_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="COUNTER"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:singleLine="true" />

    <!-- Interactive Row: [-] Count [+] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">

        <!-- Decrease Button (Left) -->
        <Button
            android:id="@+id/widget_btn_decrement"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:minWidth="38dp"
            android:minHeight="38dp"
            android:background="@drawable/counter_btn_minus"
            android:text="−"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:includeFontPadding="false" />

        <!-- Count Value (Center) -->
        <TextView
            android:id="@+id/widget_count_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0"
            android:textColor="#0F172A"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:singleLine="true" />

        <!-- Increase Button (Right) -->
        <Button
            android:id="@+id/widget_btn_increment"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:minWidth="38dp"
            android:minHeight="38dp"
            android:background="@drawable/counter_btn_plus"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Reset Action -->
    <Button
        android:id="@+id/widget_btn_reset"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:minHeight="26dp"
        android:background="@drawable/counter_btn_reset"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Reset"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:textStyle="bold"
        android:gravity="center"
        android:includeFontPadding="false" />

</LinearLayout>
