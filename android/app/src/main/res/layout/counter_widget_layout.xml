<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_counter_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/counter_widget_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Header Title -->
    <TextView
        android:id="@+id/widget_counter_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="COUNTER BOX"
        android:textColor="#64748B"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:singleLine="true" />

    <!-- Interactive Row: [-] Count [+] -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">

        <!-- Decrease Button (Left) -->
        <Button
            android:id="@+id/widget_btn_decrement"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="44dp"
            android:minHeight="44dp"
            android:background="@drawable/counter_btn_minus"
            android:text="−"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:includeFontPadding="false" />

        <!-- Count Value (Center) -->
        <TextView
            android:id="@+id/widget_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:text="0"
            android:textColor="#0F172A"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:singleLine="true" />

        <!-- Increase Button (Right) -->
        <Button
            android:id="@+id/widget_btn_increment"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="44dp"
            android:minHeight="44dp"
            android:background="@drawable/counter_btn_plus"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Reset Action -->
    <Button
        android:id="@+id/widget_btn_reset"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:minHeight="28dp"
        android:background="@drawable/counter_btn_reset"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="Reset Counter"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:textStyle="bold"
        android:gravity="center"
        android:includeFontPadding="false" />

</LinearLayout>
